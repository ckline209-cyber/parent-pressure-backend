PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=replace-with-a-long-random-string

# Optional - AI coach personalization degrades gracefully (ai_available:false) if unset.
ANTHROPIC_API_KEY=

# Google Play Billing verification (src/utils/googlePlayBilling.js). If any of these
# are unset, /subscription/verify-purchase returns 503 rather than granting premium
# without verification - there is no insecure fallback.
#
# GOOGLE_PLAY_PACKAGE_NAME: the app's applicationId, e.g. com.parentpressure.app
# GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_FILE: path to the service account JSON key
#   downloaded from Google Cloud Console. In Play Console, that service account must
#   be granted access under Users and permissions > Invite new users, with at least
#   "View app information" + "View financial data" permissions (Finance > Financial data),
#   and the Android Publisher API must be enabled on its GCP project.
# GOOGLE_PLAY_WEBHOOK_SECRET: a random string you choose. Append it as
#   ?token=<secret> to the Pub/Sub push endpoint URL you configure in Play Console
#   (Monetization setup > Real-time developer notifications) so the webhook can tell
#   real Pub/Sub pushes apart from arbitrary requests.
GOOGLE_PLAY_PACKAGE_NAME=com.parentpressure.app
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_PLAY_WEBHOOK_SECRET=
